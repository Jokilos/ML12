    "import plotly.express as px\n",
    "\n",
    "text = '''\n",
    "\n",
    "'''        \n",
    "\n",
    "losses = []\n",
    "for line in text.splitlines():\n",
    "    sp = line.split()\n",
    "    if len(sp) > 0:\n",
    "        losses += [float(sp[-1])]\n",
    "\n",
    "print(losses)\n",
    "fig = px.line(y=losses, labels={'y':'loss'})\n",
    "fig.show()"
