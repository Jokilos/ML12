  {
    "client_msg_id": "d2ad366c-18ed-4705-8105-ae76c68ecfd0",
    "type": "message",
    "user": "U039XR2B72A",
    "text": "Closing buffers before closing contexts is good practice in programs (tests in this case). However, the driver should work, or at least not leak resources, no matter if the user mode code using it, is correct, as in this case forgetting to close. Since the buffers were created for a context, releasing (but not just closing - see the other answer) a context should also clean-up the buffers. You can use either waiting, or better use Linux file reference counting, so that the context's release is called only after the buffers' release has finished.",
    "ts": "1747025539.156499",
    "thread_ts": "1746992474.124049",
    "edited": {
      "user": "U039XR2B72A",
      "ts": "1747025943.000000"
    },
    "parent_user_id": "U08EXEBDXQD",
    "team": "TV7BVTSJK",
