              {
                "type": "text",
                "text": "handled_t dispatch(self, event) {\n  if self.event_for_us(event) {\n     return handled;\n  }\n  for ch in child_listeners {\n     if ch.dispatch(event) == handled {\n        return handled;\n     }\n  }\n  return not_handled\n}"
